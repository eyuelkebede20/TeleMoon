{
  "name": "telemoon",
  "private": true,
  "version": "0.1.0",
  "description": "Google-Drive-style web app backed by a private Telegram channel (unlimited chunked storage over MTProto).",
  "workspaces": ["server", "web"],
  "engines": { "node": ">=18" },
  "scripts": {
    "dev:server": "npm -w server run dev",
    "dev:web": "npm -w web run dev",
    "build": "npm -w web run build",
    "test": "npm -w server test",
    "start": "npm -w server run start",
    "login": "npm -w server run login"
  }
}
