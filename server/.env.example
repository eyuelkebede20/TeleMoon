# --- Telegram (my.telegram.org → API development tools) ---
TG_API_ID=
TG_API_HASH=

# Pick ONE identity:
#  A) USER SESSION (recommended — unlocks the full flow: paste a t.me/+ invite
#     link in the app, browse your existing channels/groups; premium → 4 GB parts).
#     Run `npm run login`, paste the printed string here, leave TG_BOT_TOKEN empty.
TG_SESSION=
#  B) BOT (create with @BotFather, add it as ADMIN to your channel; connect by
#     pasting the channel @name or -100… id in the app).
TG_BOT_TOKEN=

# Optional seed only — you now link a channel from the app UI and it's
# remembered in the database. Leave empty.
TG_CHANNEL_ID=

# --- App ---
PORT=8080
DATA_DIR=./data
JWT_SECRET=change-me-to-a-long-random-string
# Optional comma-separated origins for a separately hosted frontend. Leave
# empty for the recommended same-origin production build.
CORS_ORIGINS=
# Optional. Empty = anyone who reaches the page can claim a handle and enter.
# Part size in MB (max 1900; keep ≤ your server's free disk in DATA_DIR/tmp).
CHUNK_MB=1536
